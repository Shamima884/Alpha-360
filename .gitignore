# ─────────────────────────────────────────────────────────
#  Meridian — git ignores
# ─────────────────────────────────────────────────────────

# ── Secrets — NEVER commit these ─────────────────────────
backend/credentials.json
*.pem
*.key
.env
.env.*

# ── Node.js ──────────────────────────────────────────────
backend/node_modules/
package-lock.json
npm-debug.log*

# ── Local database artefacts (generated at runtime) ──────
backend/data/
*.xlsx
~$*.xlsx

# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── Dev / test scratch files (local only) ────────────────
_selftest*
_runtest.ps1
_render*
_facdeploys*
_facsrv*
_facultyui*
_gitchk*
_localsrv*
_loctest*
_port.txt
_runlocalsrv*
_dep*

# ── OS / editor ──────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# ── Dev / test scratch files (local only) ────────────────
_stu*

